<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lin_middle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="390">
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="@string/summary_text1"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@drawable/selector_summary_text"
                    android:gravity="center"
                    android:id="@+id/btn_answer1"
                    android:background="@drawable/shape_white"
                    android:layout_width="115dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="10dp"
                    android:layout_centerInParent="true"
                    android:elevation="10dp"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/summary_text2"
                    android:layout_centerInParent="true"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@drawable/selector_summary_text"
                    android:gravity="center"
                    android:id="@+id/btn_answer2"
                    android:background="@drawable/shape_white"
                    android:layout_width="115dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="10dp"
                    android:layout_centerInParent="true"
                    android:elevation="10dp"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/summary_text3"
                    android:layout_centerInParent="true"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@drawable/selector_summary_text"
                    android:gravity="center"
                    android:id="@+id/btn_answer3"
                    android:background="@drawable/shape_white"
                    android:layout_width="180dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="10dp"
                    android:layout_centerInParent="true"
                    android:elevation="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@drawable/selector_summary_text"
                    android:gravity="center"
                    android:id="@+id/btn_answer4"
                    android:background="@drawable/shape_white"
                    android:layout_width="180dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="10dp"
                    android:layout_centerInParent="true"
                    android:elevation="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@drawable/selector_summary_text"
                    android:gravity="center"
                    android:id="@+id/btn_answer5"
                    android:background="@drawable/shape_white"
                    android:layout_width="115dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="10dp"
                    android:text="오후 10시 30분"
                    android:layout_centerInParent="true"
                    android:elevation="10dp"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/summary_text4"
                    android:layout_centerInParent="true"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="39"/>
        <View
            android:background="@color/silver_two"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="41dp"
            android:layout_marginRight="41dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="91">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_analysis"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:text="@string/analysis"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</android.support.design.widget.CoordinatorLayout>
