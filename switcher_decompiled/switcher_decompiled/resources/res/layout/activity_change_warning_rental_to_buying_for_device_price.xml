<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/rl_root"
    android:background="@color/very_light_blue"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@color/white"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="56">
        <ImageView
            android:id="@+id/btn_close"
            android:background="@drawable/btn_close_dark_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/charcoal_grey"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="제품 가격"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="25dp"
        android:paddingTop="28dp"
        android:paddingRight="25dp"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="512">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/blue_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="1. &apos;렌탈&apos;에서 &apos;바로 구매하기&apos;로 변경 시 금액 계산은 다음 제품가격과 같습니다."/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/blue_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:text="- 1구 제품가격 : 57,000원"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/blue_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="- 2구 제품가격 : 62,000원"/>
    </LinearLayout>
</LinearLayout>
