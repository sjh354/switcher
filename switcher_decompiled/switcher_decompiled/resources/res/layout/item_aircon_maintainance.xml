<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:gravity="center"
        android:id="@+id/cv_reservation"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="9dp"
        android:layout_marginBottom="2dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        card:cardBackgroundColor="@color/white"
        card:cardCornerRadius="3dp"
        card:cardElevation="1dp">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/btn_delete"
                android:layout_width="40dp"
                android:layout_height="40dp">
                <ImageView
                    android:background="@drawable/delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="top"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_below="@+id/btn_delete">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="27">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/charcoal_grey"
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:text="아침 기상"/>
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="40">
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp">
                        <RelativeLayout
                            android:id="@+id/rl_reservation_temperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/periwinkle"
                                android:id="@+id/tv_temperature"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20"/>
                            <TextView
                                android:textSize="9sp"
                                android:textColor="@color/periwinkle"
                                android:id="@+id/tv_temperature_symbol"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="℃"
                                android:layout_toRightOf="@+id/tv_temperature"
                                android:layout_alignParentTop="true"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/charcoal_grey"
                            android:id="@+id/tv_start_date_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:text="오전 09:00"
                            android:layout_toRightOf="@+id/rl_reservation_temperature"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/charcoal_grey"
                            android:id="@+id/tv_datetime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:text="~"
                            android:layout_toRightOf="@+id/tv_start_date_time"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/charcoal_grey"
                            android:id="@+id/tv_end_date_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:text="오전 09:00"
                            android:layout_toRightOf="@+id/tv_datetime"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/charcoal_grey"
                            android:id="@+id/tv_day_of_the_week"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:text="월 화 수 목 금 토"
                            android:layout_toRightOf="@+id/tv_end_date_time"/>
                    </RelativeLayout>
                </RelativeLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="10"/>
            </LinearLayout>
            <RelativeLayout
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:onClick="onSwitchEnable">
                <com.rey.material.widget.Switch
                    android:id="@+id/sc_enable"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="3dp"
                    android:layout_centerInParent="true"
                    android:layout_centerVertical="true"
                    style="@style/LightSwitch"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:background="@color/pale_grey"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
