<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/lin_middle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="91">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/questionnaire_doc"
                android:layout_centerInParent="true"
                android:lineSpacingExtra="10dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="276">
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/viewpager"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:overScrollMode="never"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="56">
            <kr.switcher.switcherm.ui.questionnaire.indicator.QuestionnaireIndicator
                android:id="@+id/indicator"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                app:ci_drawable="@drawable/ic_circle_checked"
                app:ci_drawable_unselected="@drawable/ic_circle_unchecked"
                app:ci_height="15dp"
                app:ci_margin="10dp"
                app:ci_width="15dp"/>
        </LinearLayout>
        <RelativeLayout
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="91">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/off_blue"
                android:gravity="center"
                android:id="@+id/btn_submit"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:text="@string/submit"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</android.support.design.widget.CoordinatorLayout>
