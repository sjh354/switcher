<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_container"
    android:background="#ffffffff"
    android:layout_width="match_parent"
    android:layout_height="135dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="40"/>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="276">
            <ImageView
                android:id="@+id/iv_switcher_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="33dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <RelativeLayout
                android:id="@+id/rl_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_switcher_icon"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/charcoal_grey"
                    android:id="@+id/tv_switcher_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:text="Switcher&apos;s Studio"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/cool_grey"
                    android:id="@+id/tv_serial_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kim Jin Woo"
                    android:layout_below="@+id/tv_switcher_name"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true">
                <ImageView
                    android:id="@+id/iv_widget_status"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginBottom="7dp"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/bluegrey_two"
                    android:gravity="center"
                    android:id="@+id/tv_widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/iv_widget_status"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="33">
            <ImageView
                android:id="@+id/iv_arrow"
                android:background="@drawable/btn_arrow_right"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="@color/pale_grey"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
