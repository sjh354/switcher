<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/very_light_blue"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="56">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/charcoal_grey"
                android:id="@+id/tv_start_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/application_name"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="512">
            <EditText
                android:textColor="@color/charcoal_grey"
                android:textColorHint="@color/cool_grey"
                android:gravity="center_horizontal"
                android:id="@+id/et_share_code"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:hint="공유코드"
                android:numeric="integer"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/lin_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="21dp"
                android:layout_below="@+id/et_share_code">
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="40"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cool_grey_two"
                    android:gravity="center"
                    android:id="@+id/btn_confirm"
                    android:background="@drawable/shape_periwinkle"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:text="@string/confirm"
                    android:layout_weight="280"/>
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="40"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
