<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_root"
    android:tag="layout/fragment_return_confirm_0"
    android:background="@color/very_light_blue"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:id="@+id/pb_searching"
        android:tag="binding_1"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerInParent="true"
        style="?android:attr/progressBarStyleSmall"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="297">
            <ImageView
                android:id="@+id/iv_calendar"
                android:background="@drawable/group_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="38dp"
                android:layout_centerHorizontal="true"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_calendar"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cool_grey_two"
                    android:gravity="center"
                    android:id="@+id/tv_return_confirm_message1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/return_confirm_message1"/>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/rl_middle_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_return_confirm_message1">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cool_grey_two"
                        android:id="@+id/tv_return_confirm_message2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/return_confirm_message2"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/periwinkle"
                        android:id="@+id/tv_return_confirm_message3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/return_confirm_message3"
                        android:layout_toRightOf="@+id/tv_return_confirm_message2"
                        android:layout_alignBottom="@+id/tv_return_confirm_message2"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cool_grey_two"
                        android:id="@+id/tv_return_confirm_message4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/return_confirm_message4"
                        android:layout_toRightOf="@+id/tv_return_confirm_message3"
                        android:layout_alignBottom="@+id/tv_return_confirm_message2"/>
                </RelativeLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cool_grey_two"
                    android:gravity="center"
                    android:id="@+id/tv_return_confirm_message5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/return_confirm_message5"
                    android:layout_below="@+id/rl_middle_message"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="113">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="56">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cool_grey_two"
                    android:paddingLeft="18dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/reservation_date_return"
                    android:layout_weight="92"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/charcoal_grey"
                    android:tag="binding_2"
                    android:paddingLeft="20dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="268"/>
            </LinearLayout>
            <View
                android:background="@color/pale_grey"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="56">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cool_grey_two"
                    android:paddingLeft="18dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/invoice_number"
                    android:layout_weight="92"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/charcoal_grey"
                    android:tag="binding_3"
                    android:paddingLeft="20dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="268"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="103">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/periwinkle"
                android:gravity="center"
                android:background="@drawable/shape_periwinkle"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="@string/confirm"
                android:layout_weight="280"
                android:onClick="onReturnConfirmButtonClicked"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
