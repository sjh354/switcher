<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/questionnaire_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/lin_center"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="56">
        <ImageView
            android:id="@+id/btn_previous"
            android:background="@drawable/btn_arrow_left_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_remoteControl_command"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="514">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="150">
            <ImageView
                android:id="@+id/iv_remote"
                android:background="@drawable/ic_ir_remocon_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="70">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:background="@drawable/ic_label_white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:paddingLeft="8dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/remote_controler_command"
                        android:layout_weight="70"/>
                    <EditText
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/silver"
                        android:gravity="center_vertical"
                        android:id="@+id/et_command"
                        android:background="@android:color/transparent"
                        android:paddingLeft="5dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:minWidth="100dp"
                        android:hint="@string/hint_edit_command"
                        android:singleLine="true"
                        android:maxLength="10"
                        android:layout_weight="165"
                        android:imeOptions="actionDone"/>
                </LinearLayout>
                <View
                    android:background="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="10dp"
                    android:layout_alignParentBottom="true"
                    android:alpha="0.16"/>
            </RelativeLayout>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="133">
            <com.wang.avi.AVLoadingIndicatorView
                android:id="@+id/pb_registering"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                app:indicatorName="BallBeatIndicator"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="56">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/silver_three"
                android:gravity="center"
                android:id="@+id/btn_command_register"
                android:background="@drawable/shape_off_blue_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/register_command"
                android:layout_weight="280"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="61"/>
    </LinearLayout>
</LinearLayout>
