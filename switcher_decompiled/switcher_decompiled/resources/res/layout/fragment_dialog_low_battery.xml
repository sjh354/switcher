<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_low_battery"
    android:background="@color/charcoal_grey"
    android:paddingLeft="21dp"
    android:layout_width="match_parent"
    android:layout_height="104dp">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/lin_lowbattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp">
            <ImageView
                android:background="@drawable/ic_lowbattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/very_light_blue"
                android:id="@+id/tv_current_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_battery"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/very_light_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/charge_switcher"
            android:layout_below="@+id/lin_lowbattery"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true">
        <ImageView
            android:background="@drawable/ic_charge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
</RelativeLayout>
