<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/lin_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <RelativeLayout
            android:gravity="center_vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="184">
            <ImageView
                android:id="@+id/iv_switcher_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/charcoal_grey"
                android:id="@+id/tv_room_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_switcher_icon"
                android:layout_centerHorizontal="true"/>
            <RelativeLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_below="@+id/tv_room_name">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/periwinkle"
                    android:gravity="center"
                    android:id="@+id/tv_switcher_type"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginRight="5dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/cool_grey_two"
                    android:gravity="center"
                    android:id="@+id/using"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="사용중"
                    android:layout_toRightOf="@+id/tv_switcher_type"/>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/very_light_blue"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="328">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="40">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/charcoal_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/order_text"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/blue_grey_two"
                    android:id="@+id/tv_owner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLength="10"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <View
                    android:background="@color/pale_grey"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="40">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/blue_grey_two"
                    android:id="@+id/tv_serial_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLength="10"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <View
                    android:background="@color/pale_grey"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_alignParentBottom="true"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/charcoal_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/product_code_text"
                    android:layout_alignBaseline="@+id/tv_serial_number"
                    android:layout_alignBottom="@+id/tv_serial_number"
                    android:layout_alignParentStart="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/lin_owner_menu"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="210">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="40">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/blue_grey_two"
                        android:id="@+id/tv_share_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLength="15"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                    <View
                        android:background="@color/pale_grey"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_alignParentBottom="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/charcoal_grey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/share_code_text"
                        android:layout_alignBaseline="@+id/tv_share_code"
                        android:layout_alignBottom="@+id/tv_share_code"
                        android:layout_alignParentStart="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="40"
                    android:onClick="onPaymentCardMenuButtonClicked">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/charcoal_grey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_card_text"
                        android:layout_centerVertical="true"/>
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true">
                        <ImageButton
                            android:id="@+id/ib_payment_card"
                            android:background="@drawable/ic_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/periwinkle"
                            android:id="@+id/tv_payment_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLength="15"
                            android:layout_toLeftOf="@+id/ib_payment_card"/>
                    </RelativeLayout>
                    <View
                        android:background="@color/pale_grey"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="40"
                    android:onClick="onPlanMenuButtonClicked">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/charcoal_grey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_type"
                        android:layout_centerVertical="true"/>
                    <RelativeLayout
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true">
                        <ImageView
                            android:id="@+id/ib_plan"
                            android:background="@drawable/ic_arrow"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/cool_grey_two"
                            android:id="@+id/tv_free_trial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/free_trial"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/periwinkle"
                            android:id="@+id/tv_payment_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLength="10"
                            android:layout_toLeftOf="@+id/tv_free_trial"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                    <View
                        android:background="@color/pale_grey"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="40">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/charcoal_grey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/first_payment_at"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/blue_grey_two"
                        android:id="@+id/tv_first_payment_at"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLength="13"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                    <View
                        android:background="@color/pale_grey"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="58">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="87"/>
                    <TextView
                        android:textColor="@color/salmon"
                        android:gravity="center"
                        android:background="@drawable/shape_salmon"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:text="@string/return_button_text"
                        android:layout_weight="186"
                        android:onClick="onReturnButtonClicked"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="87"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
