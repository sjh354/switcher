<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog"
    android:layout_width="280dp"
    android:layout_height="388dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="43dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/carnation"
            android:gravity="center"
            android:id="@+id/icon"
            android:background="@drawable/shape_carnation"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginLeft="13dp"
            android:text="!"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/carnation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="결제방식 변경하기 전 꼭 읽어주세요."
            android:layout_toRightOf="@+id/icon"
            android:layout_centerVertical="true"/>
        <View
            android:background="@color/warm_grey_20"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="342dp">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/periwinkle"
                android:id="@+id/buy_now_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="바로 구매하기"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/charcoal_grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로"
                android:layout_toRightOf="@+id/buy_now_text"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/charcoal_grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="변경하시겠어요?"
                android:layout_below="@+id/buy_now_text"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/slate_grey"
                android:id="@+id/doc1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="바로 구매하기로 결제방식을 변경하면,"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/periwinkle"
                android:id="@+id/doc2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="이전 방식으로 돌아갈 수 없습니다."
                android:layout_below="@+id/doc1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/slate_grey"
                android:id="@+id/doc3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="납부한 금액은 "
                android:layout_below="@+id/doc2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/periwinkle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="환불되지 않고,"
                android:layout_toRightOf="@+id/doc3"
                android:layout_below="@+id/doc2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/slate_grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="금액에 비례하여 할인을 해드립니다."
                android:layout_below="@+id/doc3"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/slate_grey"
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="결제 금액 : "/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/slate_grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16,530원"
                android:layout_toRightOf="@+id/price"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/periwinkle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전환 시 유의사항"
                android:lineSpacingExtra="10sp"/>
        </RelativeLayout>
        <RelativeLayout
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/periwinkle"
                android:id="@+id/btn_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="변경하기"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/slate_grey"
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="30dp"
                android:text="취소"
                android:layout_toLeftOf="@+id/btn_change"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
