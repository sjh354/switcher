<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rl_root"
    android:tag="layout/fragment_linker_test_ir_command_0"
    android:background="@color/very_light_blue2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="50"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="263">
        <ImageView
            android:background="@drawable/bg_ir_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="70">
        <TextView
            android:textColor="@color/blue_grey"
            android:gravity="center_horizontal"
            android:paddingLeft="10dp"
            android:paddingTop="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="아래의 버튼을 누르면 링커가 명령어를 테스트 합니다.\10정상적으로 동작하는지 확인해주세요.\10 (링커와 제품이 마주보고 있어야 해요.)"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="50">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"/>
            <Button
                android:textSize="16sp"
                android:textColor="@color/periwinkle"
                android:gravity="center"
                android:id="@+id/btn_test_command"
                android:background="@drawable/shape_periwinkle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="명령어 테스트 하기"
                android:layout_weight="280"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"/>
        </LinearLayout>
        <com.wang.avi.AVLoadingIndicatorView
            android:id="@+id/pb_registering"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            custom:indicatorColor="@color/periwinkle2"
            custom:indicatorName="BallBeatIndicator"/>
    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="61"/>
</LinearLayout>
