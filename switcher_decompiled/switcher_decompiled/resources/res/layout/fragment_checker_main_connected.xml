<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_root"
    android:background="@color/very_light_blue"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="8">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/slate_grey"
                android:id="@+id/tv_checker_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" "
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/slate_grey"
                android:id="@+id/tv_is_opened"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" "
                android:layout_toRightOf="@+id/tv_checker_name"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="36">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="25"/>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="50">
                <ImageView
                    android:id="@+id/iv_checker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="25"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="21">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="12"/>
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/rl_surveillance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/btn_surveillance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/selector_checker_surveillance"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/slate_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/surveillance"
                    android:layout_below="@+id/btn_surveillance"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/rl_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/btn_history"
                    android:background="@drawable/selector_checker_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/slate_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history"
                    android:layout_below="@+id/btn_history"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/rl_setting"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:layout_alignParentRight="true">
                <ImageView
                    android:id="@+id/btn_setting"
                    android:background="@drawable/btn_checker_setting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/slate_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting"
                    android:layout_below="@+id/btn_setting"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="12"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
